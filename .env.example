# ---------------------------------------------------------------------------
# GW Immobilier — environment variables (all optional, all public)
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values supplied by the owner.
# Every variable below is exposed to the browser through NEXT_PUBLIC_*.
# NEVER put secrets, API keys or database URLs in this file.
# ---------------------------------------------------------------------------

# WhatsApp Business line — digits only, international format, no "+" or spaces.
# Example: 213555123456
NEXT_PUBLIC_WHATSAPP_NUMBER=213600000000

# Phone number shown in the header, footer and contact page.
NEXT_PUBLIC_PHONE_NUMBER=+213 00 00 00 00

# Public contact e-mail.
NEXT_PUBLIC_CONTACT_EMAIL=contact@gw-immobilier.example

# Canonical base URL, used by the sitemap and the OpenGraph metadata.
# Example: https://gw-immobilier.dz
NEXT_PUBLIC_SITE_URL=https://gw-immobilier-platform.vercel.app
